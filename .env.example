# =============================================================================
# meta_automation — arquivo de exemplo de configuração
# -----------------------------------------------------------------------------
# Copie para `.env` (cp .env.example .env) e preencha os valores reais.
# NUNCA versione o `.env` — ele contém segredos.
#
# Legenda:
#   [OBRIGATÓRIA]  → sem ela o painel NÃO sobe / login quebra.
#   [pipeline]     → o app sobe sem ela, mas a esteira de automação fica
#                    degradada/desabilitada (CNPJ, SMS, e-mail, Cloudflare…).
#   (demais)       → têm default no config.py; só mude se souber o que faz.
#
# Todas as variáveis abaixo são lidas em config.py / core/auth.py.
# A seção do COLETOR ADMIN (final) usa um .env PRÓPRIO em admin/ — veja a nota.
# =============================================================================


# -----------------------------------------------------------------------------
# AUTENTICAÇÃO DO PAINEL (1 operador por instância) — core/auth.py
# JWT HS256, validade de 12h. Sem estas 3, /api/login levanta erro.
# -----------------------------------------------------------------------------
# [OBRIGATÓRIA] usuário do painel
# >>> PREENCHER <<<
PANEL_USERNAME=
# [OBRIGATÓRIA] senha do painel
# >>> PREENCHER <<<
PANEL_PASSWORD=
# [OBRIGATORIA] chave de assinatura do JWT
# >>> PREENCHER <<<
PANEL_AUTH_SECRET=
                                              # gere com: python -c "import secrets;print(secrets.token_urlsafe(48))"


# -----------------------------------------------------------------------------
# TELEMETRIA (instância → coletor admin) — reporter (frente paralela)
# Em branco → o reporter fica DESLIGADO; a instância roda normal, só não
# empurra dados pro coletor central. Preencha p/ aparecer no painel do dono.
# -----------------------------------------------------------------------------
# [pipeline] ex.: https://admin.seudominio.com  (vazio = telemetria off)
COLLECTOR_URL=
# id estável desta instância (ex.: socio-joao-01)
INSTANCE_ID=
# nome legível (ex.: "João — Notebook")
INSTANCE_NAME=
# token desta instância; precisa constar em INSTANCE_TOKENS do admin
INSTANCE_TOKEN=
TELEMETRY_INTERVAL_S=30                        # intervalo (s) entre heartbeats/empurrões


# -----------------------------------------------------------------------------
# ADSPOWER (navegador antidetect via Local API) — dependência EXTERNA
# O AdsPower precisa estar ABERTO e LOGADO na máquina. Default local.
# -----------------------------------------------------------------------------
ADSPOWER_API_URL=http://127.0.0.1:50325       # [pipeline] endpoint da Local API do AdsPower
ADSPOWER_START_PATH=/api/v1/browser/start
ADSPOWER_STOP_PATH=/api/v1/browser/stop
ADSPOWER_TIMEOUT_S=30
ADSPOWER_CDP_CONNECT_TIMEOUT_MS=30000          # teto p/ connect_over_cdp no browser aberto
ADSPOWER_FALLBACK_DIRECT=false                 # true = se AdsPower falhar, lança browser direto (usa PROXY_* do env)
# chave global da conta AdsPower (ignorada em builds antigos)
ADSPOWER_API_KEY=


# -----------------------------------------------------------------------------
# PLAYWRIGHT
# -----------------------------------------------------------------------------
PLAYWRIGHT_HEADLESS=true                        # false p/ ver o navegador (debug)
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_NAV_TIMEOUT_MS=45000
PLAYWRIGHT_NAV_TIMEOUT_MS_PROXY=120000          # navegação via proxy é mais lenta
# vazio = UA Chrome padrão do config.py
PLAYWRIGHT_USER_AGENT=


# -----------------------------------------------------------------------------
# PROXY DEDICADO (modo fallback / sem AdsPower)
# Só use quando o perfil NÃO é gerenciado pelo AdsPower. Com AdsPower, o proxy
# do perfil já vem aplicado — DEIXE EM BRANCO.
# -----------------------------------------------------------------------------
# ex.: http://1.2.3.4:8000
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=


# -----------------------------------------------------------------------------
# ROTAÇÃO DE IP 4G / PROXY MÓVEL (pré-boot do navegador)
# Em branco → rotação é PULADA silenciosamente.
# -----------------------------------------------------------------------------
# URL HTTP que dispara o reset do modem/rotação
PROXY_ROTATION_URL=
PROXY_ROTATION_COOLDOWN_S=15                     # espera (s) pra rede estabilizar após o reset
PROXY_ROTATION_TIMEOUT_S=20                      # timeout (s) da requisição de reset


# -----------------------------------------------------------------------------
# CAPTCHA — 2captcha
# -----------------------------------------------------------------------------
# [pipeline] vazio = sem resolução automática 2captcha
TWO_CAPTCHA_API_KEY=
TWO_CAPTCHA_BASE_URL=https://2captcha.com
TWO_CAPTCHA_POLL_INTERVAL_S=5
TWO_CAPTCHA_TIMEOUT_S=180

# CAPTCHA — CapSolver (cobre reCAPTCHA Enterprise/Arkose que o 2captcha não resolve)
# quando setada, o runner prefere CapSolver ao 2captcha
CAPSOLVER_API_KEY=
CAPSOLVER_BASE_URL=https://api.capsolver.com
CAPSOLVER_POLL_INTERVAL_S=3
CAPSOLVER_TIMEOUT_S=180
CAPSOLVER_RECAPTCHA_ENTERPRISE=true             # false se descobrir que é reCAPTCHA v2 comum
CAPTCHA_MANUAL_TIMEOUT_S=300                     # janela (s) p/ resolução manual; 0 desliga


# -----------------------------------------------------------------------------
# SMS — recepção (numero-virtual.com)
# -----------------------------------------------------------------------------
# [pipeline] vazio = só validação manual de SMS
# >>> PREENCHER <<<
NUMERO_VIRTUAL_API_KEY=
NUMERO_VIRTUAL_BASE_URL=https://app.numero-virtual.com/api/v1
NUMERO_VIRTUAL_SERVICE_ID=60009
NUMERO_VIRTUAL_SERVICE_CODE=ot
NUMERO_VIRTUAL_SERVICE_NAME=Outros apps/Site
NUMERO_VIRTUAL_COUNTRY_ID=24
NUMERO_VIRTUAL_COUNTRY_CODE=br
NUMERO_VIRTUAL_TARGET_PRICE=273
NUMERO_VIRTUAL_PURCHASE_API_ID=3
NUMERO_VIRTUAL_CUSTOMER_SESSION=
NUMERO_VIRTUAL_PRICE_STRICT=false
# Aliases legados mantidos por compatibilidade com partes antigas da esteira.
SMS24H_API_KEY=
SMS24H_BASE_URL=https://app.numero-virtual.com/api/v1
SMS24H_SERVICE_CODE=ot
SMS24H_COUNTRY_CODE=br
SMS24H_OPERATOR=
# A API pública não documenta cancelamento/reembolso para faixas rejeitadas.
# Vazio = aceita qualquer DDD e evita acumular compras descartadas.
SMS24H_ALLOWED_DDDS=
SMS24H_DDD_MAX_ATTEMPTS=30
SMS_POLL_INTERVAL_S=5
SMS_POLL_TIMEOUT_S=300
SMS_API_FALLBACK_MANUAL=true                    # true = cai p/ manual se o gateway falhar/sem key
SMS_MANUAL_TIMEOUT_S=300                          # janela (s) da validação manual de SMS
SMS_VERIFICATION_TIMEOUT_S=600                    # timeout (s) do SMS de verificação da empresa (passo 5)

# --- sms24h.org (provedor SMS alternativo, protocolo sms-activate) -----------
# Botão "SMS24H" na aba Disparar. Facebook R$0,80 / número.
SMS24H_ORG_API_KEY=
SMS24H_ORG_BASE_URL=https://api.sms24h.org/stubs/handler_api
SMS24H_ORG_SERVICE=fb
SMS24H_ORG_COUNTRY=73

# --- SMSRush (smsrush.com.br) — provedor SMS alternativo, API REST JSON ------
# Botão "SMSRush" na aba Disparar. Facebook R$0,80 / número.
SMSRUSH_API_TOKEN=
SMSRUSH_BASE_URL=https://api.smsrush.com.br/api/v1
SMSRUSH_SERVICE_ID=42


# -----------------------------------------------------------------------------
# CNPJ / EMPRESA — BrasilAPI (fonte primária da Receita, sem auth)
# -----------------------------------------------------------------------------
BRASILAPI_BASE_URL=https://brasilapi.com.br/api/cnpj/v1
BRASILAPI_TIMEOUT_S=20

# CNPJ — Infosimples (emissão do Cartão CNPJ oficial; PDF p/ upload na Meta)
# [pipeline] sem token, a emissão do comprovante fica desabilitada
INFOSIMPLES_API_TOKEN=
INFOSIMPLES_BASE_URL=https://api.infosimples.com/api/v2
INFOSIMPLES_CNPJ_PATH=/consultas/receita-federal/cnpj
INFOSIMPLES_SERVER_TIMEOUT_S=300                 # quanto a Infosimples pode levar no portal
INFOSIMPLES_TIMEOUT_S=330                         # timeout HTTP local (MAIOR que o server-side)
INFOSIMPLES_BACKFILL_TIMEOUT_S=30                 # backfill do nº do endereço (curto, interativo)

# Telefone fixo no comprovante CNPJ (PDF do BV). Se definido, substitui SMS24h no PDF.
# Aceita só dígitos ou formatado: 11987654321 ou (11) 98765-4321
# COMPROVANTE_TELEFONE=

# -----------------------------------------------------------------------------
# E-MAIL TEMPORÁRIO — InvertTexto / Uorak (gera o e-mail comercial)
# -----------------------------------------------------------------------------
# [pipeline] sem token, e-mail cai p/ preenchimento manual
INVERTTEXTO_API_TOKEN=
INVERTTEXTO_BASE_URL=https://api.inverttexto.com
INVERTTEXTO_TIMEOUT_S=30
UORAK_EMAIL_DOMAIN=uorak.com                     # domínio fixo p/ fallback local (slug@uorak.com)


# -----------------------------------------------------------------------------
# NETLIFY — hospedagem dos sites por CNPJ (verificação de domínio no Meta)
# Substitui a Cloudflare. O normal é cadastrar o DOMÍNIO + TOKEN + LIMITE pelo
# painel (Configurações → Domínios) — não pelo .env. As vars abaixo são só
# ajustes globais/opcionais. Cada CNPJ vira um subdomínio ({slug}.{seu-dominio})
# servido por uma Netlify Edge Function (mesma página/tema do worker antigo).
# -----------------------------------------------------------------------------
NETLIFY_API_BASE=https://api.netlify.com/api/v1
# token padrão (fallback) — opcional; o recomendado é cadastrar o token junto
# do domínio na UI, pois cada domínio pode ter uma conta Netlify diferente.
NETLIFY_API_TOKEN=
NETLIFY_REQUEST_TIMEOUT_S=60
# limite padrão de sites por domínio quando não informado na UI
NETLIFY_DEFAULT_CAP=10
# espera (s) de propagação entre o deploy e o "Verificar domínio" no Meta
NETLIFY_DEPLOY_WAIT_S=15
# tentativas de poll do estado do deploy (state == "ready")
NETLIFY_DEPLOY_POLL_ATTEMPTS=30


# -----------------------------------------------------------------------------
# DATACRAZY — registro de WABA + token capturados pelo sniffer (contrato aberto)
# -----------------------------------------------------------------------------
# vazio = registro Datacrazy desabilitado
DATACRAZY_ENDPOINT=
DATACRAZY_API_KEY=
DATACRAZY_TIMEOUT_S=30


# -----------------------------------------------------------------------------
# LOCALE / IDIOMA
# -----------------------------------------------------------------------------
TARGET_LOCALE=pt_BR
TARGET_LOCALE_HEADER=pt-BR
TARGET_TIMEZONE=America/Sao_Paulo
LANGUAGE_PREFERENCES_URL=https://www.facebook.com/settings/?tab=language_and_region
FORCE_LOCALE=true                                 # força a UI pt-BR antes da esteira


# -----------------------------------------------------------------------------
# OCR (Tesseract) — fallback de leitura de documentos
# -----------------------------------------------------------------------------
# caminho do binário tesseract (vazio = usa o do PATH; no macOS o brew instala no PATH)
TESSERACT_CMD=
TESSERACT_LANG=por


# -----------------------------------------------------------------------------
# URLs / SELETORES DO FLUXO META (raramente mudam; defaults no config.py)
# -----------------------------------------------------------------------------
# vazio = login.php?locale=<TARGET_LOCALE>
META_LOGIN_URL=
META_HOME_URL=https://www.facebook.com/
# vazio = seletor padrão do config.py
POST_LOGIN_INDICATOR=
BUSINESS_OVERVIEW_URL=https://business.facebook.com/overview
# vazio = URL determinística do config.py
BUSINESS_CREATE_PORTFOLIO_URL=
BUSINESS_INFO_URL=https://business.facebook.com/settings/info
BUSINESS_DOMAINS_URL=https://business.facebook.com/settings/owned-domains
BUSINESS_SECURITY_URL=https://business.facebook.com/settings/security
BUSINESS_WHATSAPP_URL=https://business.facebook.com/settings/whatsapp-business-accounts

# --- Passo 4: CONTA DE ANUNCIOS (substituiu a WABA em 2026-09) --------------
# CRIAR_WABA=true volta a criar a conta do WhatsApp (passo 4b) e reativa o
# registro no Datacrazy. Deixe false para a esteira criar SO a conta de
# anuncios, com o mesmo nome da BM e moeda BRL.
CRIAR_WABA=false
BUSINESS_AD_ACCOUNTS_URL=https://business.facebook.com/settings/ad-accounts
AD_ACCOUNT_CURRENCY=BRL
AD_ACCOUNT_TIMEZONE=America/Sao_Paulo

# --- Passo 2: esperar o dominio verificar antes de avancar ------------------
# Janela TOTAL de espera do passo 2 (metade para o probe HTTP da metatag, o
# resto re-clicando 'Verificar dominio'). 180 = 3 min.
DOMAIN_VERIFY_WAIT_S=180
# true = run PARA no passo 2 se o dominio nao verificar (retomavel pelo botao
# 'Continuar BM'). false = volta ao antigo, que seguia otimista.
DOMAIN_VERIFY_STRICT=true
BUSINESS_SSO_MANUAL_TIMEOUT_S=180                 # espera (s) pelo clique manual no SSO; 0 desliga


# -----------------------------------------------------------------------------
# VERIFICAÇÃO DA EMPRESA (passo 5 / Business Verification)
# -----------------------------------------------------------------------------
BV_AUTO_SUBMIT=true                               # false = para após upload (validação humana antes do submit irreversível)
BV_SMS_RESEND_ATTEMPTS=3                           # nº de tentativas de código SMS antes de desistir
KEEP_BROWSER_OPEN_ON_BV_ERROR=false                # true = deixa navegador/perfil abertos no erro (debug; vaza slots em lote)


# -----------------------------------------------------------------------------
# COMPORTAMENTO HUMANO (anti-detecção de digitação/esperas)
# -----------------------------------------------------------------------------
# --- Ritmo do bot: perfil AGRESSIVO (2026-09) ------------------------------
# Antes: digitacao 100-300ms/char e pausas de 1-3s (media 2s) — medicao de 12
# runs mostrou ~6 min de espera pura numa run de ~13 min. O que disfarca o
# padrao e a VARIACAO aleatoria, nao a lentidao; estes valores mantem a
# variacao num ritmo de humano rapido.
# Se a Meta comecar a restringir BMs ("cadeado vermelho"), suba estes 4
# numeros de volta (ex.: 40/120 e 400/1400) — nada mais precisa mudar.
TYPING_DELAY_MIN_MS=8
TYPING_DELAY_MAX_MS=25
ORGANIC_WAIT_MIN_MS=100
ORGANIC_WAIT_MAX_MS=300
# Teto do "networkidle": o Facebook quase nunca fica idle, entao a espera
# virava timeout cheio de 60s. O fluxo ja segue em frente no timeout.
NETWORKIDLE_TIMEOUT_MS=6000
# Dialogo de erro no fim de uma run falha (0 desliga).
ERROR_DIALOG_TIMEOUT_S=15


# -----------------------------------------------------------------------------
# MODOS DE OPERAÇÃO / DEBUG
# -----------------------------------------------------------------------------
PREFLIGHT_ENABLED=true                             # L2: valida ambiente antes de navegar; false só p/ depurar
RECON_DUMP=false                                   # percorre todas as telas salvando DOM+screenshot, sem preencher
CALIBRATION_MODE=false                             # esteira não aborta no 1º passo que falha (acelera fixes)
MEASURE_ASSET_BYTES=false                           # só-log: contabiliza bytes por (resource_type, domínio)
# vazio = .state/storage_state.json
STORAGE_STATE_PATH=


# =============================================================================
# >>> COLETOR ADMIN (serviço SEPARADO em admin/) <<<
# -----------------------------------------------------------------------------
# O coletor central é um FastAPI INDEPENDENTE (admin/server.py) que recebe a
# telemetria das instâncias. Ele NÃO roda na máquina do operador — roda no
# servidor do dono. Tem o PRÓPRIO arquivo .env (dentro de admin/), com:
#
#   ADMIN_USERNAME=admin                  # usuário do painel admin
#   ADMIN_PASSWORD=troque-esta-senha      # senha do painel admin
#   ADMIN_AUTH_SECRET=segredo-admin-longo # chave de assinatura do JWT admin
#   ADMIN_CORS_ORIGIN=*                   # origem CORS permitida (use o domínio real em prod, não *)
#   INSTANCE_TOKENS=tokenJoao:João,tokenMaria:Maria
#       # mapa token→nome das instâncias autorizadas a empurrar telemetria.
#       # Cada token aqui deve casar com o INSTANCE_TOKEN da instância correspondente.
#
# Subir o coletor:  uvicorn admin.server:app --port 8900
# As variáveis acima são lidas em admin/server.py — NÃO precisam estar neste .env.
# =============================================================================
