# Base URL da API do coletor (Frente 3). Vazio = chamadas relativas (/admin/...),
# usando o proxy do vite.config.js em dev. Em produção, aponte pro coletor:
#   VITE_ADMIN_API=https://coletor.suaempresa.com
VITE_ADMIN_API=

# Modo mock: sobe sem backend, com 2 instâncias de exemplo.
#   VITE_USE_MOCK=true  → ignora a rede e serve dados fake
VITE_USE_MOCK=false
